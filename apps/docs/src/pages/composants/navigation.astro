---
import DocsLayout from '../../layouts/DocsLayout.astro';
import CodeBlock from '../../components/CodeBlock.astro';
---

<DocsLayout
  title="Navigation"
  description="Composants de navigation du DSML (header institutionnel, menu principal, sous-menus dropdown, drawer mobile, breadcrumb, pagination, stepper, sidenav)."
  pageTitle="Navigation & Structure"
  pageSubtitle="Composants essentiels pour structurer la navigation globale et secondaire de vos applications administrative et portails publics."
>

  <h2 class="ml-title-2">01. Barre de Navigation Principale (.ml-header-nav)</h2>
  <p class="ml-body" style="color: var(--ml-color-neutral-600); margin-bottom: var(--ml-space-4);">
    La barre de navigation principale (<code>.ml-header-nav</code>) héberge les liens de premier niveau de votre application web ou portail institutionnel. Elle gère la mise en avant de l'onglet actif (<code>.ml-nav-item.active</code>) avec soulignement dynamique vert national et survol lumineux.
  </p>

  <div class="demo-preview">
    <div style="background: var(--ml-color-neutral-0); border: 1px solid var(--ml-color-neutral-200); border-radius: var(--ml-radius-s); overflow: hidden; width: 100%;">
      <nav class="ml-header-nav" id="demo-main-nav" aria-label="Menu principal de démonstration">
        <a href="#" class="ml-nav-item active demo-main-nav-link" onclick="return false;">Accueil</a>
        <a href="#" class="ml-nav-item demo-main-nav-link" onclick="return false;">Démarches en ligne</a>
        <a href="#" class="ml-nav-item demo-main-nav-link" onclick="return false;">Ministères & Institutions</a>
        <a href="#" class="ml-nav-item demo-main-nav-link" onclick="return false;">Actualités & Presse</a>
        <a href="#" class="ml-nav-item demo-main-nav-link" onclick="return false;">Espace Citoyen</a>
      </nav>
    </div>
  </div>

  <CodeBlock code={`<nav class="ml-header-nav" aria-label="Menu principal">
  <a href="/" class="ml-nav-item active">Accueil</a>
  <a href="/demarches/" class="ml-nav-item">Démarches</a>
  <a href="/ministeres/" class="ml-nav-item">Ministères</a>
  <a href="/actualites/" class="ml-nav-item">Actualités</a>
</nav>`} lang="html" />

  <h2 class="ml-title-2" style="margin-top: var(--ml-space-8);">02. Sous-Menu et Menu Déroulant (Dropdown)</h2>
  <p class="ml-body" style="color: var(--ml-color-neutral-600); margin-bottom: var(--ml-space-4);">
    Les sous-menus contextuels s'affichent sous forme de panneau flottant en verre dépoli (glassmorphism) lors du survol ou du clic sur l'élément déclencheur.
  </p>

  <div class="demo-preview" style="display: flex; justify-content: center; padding: 40px var(--ml-space-4);">
    <div class="ml-dropdown" id="demo-dropdown">
      <button type="button" class="ml-dropdown-trigger" id="demo-dropdown-trigger" aria-expanded="false">
        <span>Espace Citoyen / Agent</span>
        <svg viewBox="0 0 24 24" style="width: 14px; height: 14px; fill: none; stroke: currentColor; stroke-width: 2; transition: transform 0.2s ease;"><path d="M6 9l6 6 6-6"></path></svg>
      </button>
      <div class="ml-dropdown-menu" id="demo-dropdown-menu">
        <div class="ml-dropdown-title">Accès sécurisé</div>
        <a href="#" class="ml-dropdown-item active" onclick="return false;">
          <span class="ml-dropdown-dot user"></span>
          Mes Démarches en ligne
        </a>
        <a href="#" class="ml-dropdown-item" onclick="return false;">
          <span class="ml-dropdown-dot agent"></span>
          Portail Agent Public
        </a>
        <div class="ml-dropdown-divider"></div>
        <a href="#" class="ml-dropdown-item" onclick="return false;">Aide & Support technique</a>
      </div>
    </div>
  </div>

  <CodeBlock code={`<!-- Menu déroulant (Sous-menu contextuel) -->
<div class="ml-dropdown">
  <button type="button" class="ml-dropdown-trigger" aria-expanded="true">
    <span>Espace Citoyen</span>
    <svg viewBox="0 0 24 24" width="14" height="14"><path d="M6 9l6 6 6-6"></path></svg>
  </button>
  <div class="ml-dropdown-menu show">
    <div class="ml-dropdown-title">Accès sécurisé</div>
    <a href="#" class="ml-dropdown-item active">
      <span class="ml-dropdown-dot user"></span>
      Mes Démarches en ligne
    </a>
    <a href="#" class="ml-dropdown-item">
      <span class="ml-dropdown-dot agent"></span>
      Portail Agent Public
    </a>
    <div class="ml-dropdown-divider"></div>
    <a href="#" class="ml-dropdown-item">Aide & Support</a>
  </div>
</div>`} lang="html" />

  <h2 class="ml-title-2" style="margin-top: var(--ml-space-8);">03. Fil d'Ariane (Breadcrumbs)</h2>
  <div class="demo-preview">
    <nav class="ml-breadcrumb" aria-label="Fil d'Ariane" id="demo-breadcrumb">
      <ol class="ml-breadcrumb-list">
        <li class="ml-breadcrumb-item"><a href="#" class="demo-bc-link" onclick="return false;">Accueil</a></li>
        <li class="ml-breadcrumb-item"><a href="#" class="demo-bc-link" onclick="return false;">Démarches</a></li>
        <li class="ml-breadcrumb-item active" aria-current="page">Carte Consulaire</li>
      </ol>
    </nav>
  </div>
  <CodeBlock code={`<nav class="ml-breadcrumb" aria-label="Fil d'Ariane">
  <ol class="ml-breadcrumb-list">
    <li class="ml-breadcrumb-item"><a href="#">Accueil</a></li>
    <li class="ml-breadcrumb-item"><a href="#">Démarches</a></li>
    <li class="ml-breadcrumb-item active" aria-current="page">Carte Consulaire</li>
  </ol>
</nav>`} lang="html" />

  <h2 class="ml-title-2" style="margin-top: var(--ml-space-8);">04. Pagination</h2>
  <div class="demo-preview">
    <nav class="ml-pagination" aria-label="Pagination" id="demo-pagination">
      <a href="#" class="ml-pagination-btn disabled" id="demo-pag-prev" onclick="return false;">‹ Préc.</a>
      <a href="#" class="ml-pagination-btn active demo-pag-num" data-page="1" onclick="return false;">1</a>
      <a href="#" class="ml-pagination-btn demo-pag-num" data-page="2" onclick="return false;">2</a>
      <span class="ml-pagination-ellipsis">...</span>
      <a href="#" class="ml-pagination-btn demo-pag-num" data-page="10" onclick="return false;">10</a>
      <a href="#" class="ml-pagination-btn" id="demo-pag-next" onclick="return false;">Suiv. ›</a>
    </nav>
  </div>
  <CodeBlock code={`<nav class="ml-pagination" aria-label="Pagination">
  <a href="#" class="ml-pagination-btn disabled">‹ Préc.</a>
  <a href="#" class="ml-pagination-btn active">1</a>
  <a href="#" class="ml-pagination-btn">2</a>
  <span class="ml-pagination-ellipsis">...</span>
  <a href="#" class="ml-pagination-btn">10</a>
  <a href="#" class="ml-pagination-btn">Suiv. ›</a>
</nav>`} lang="html" />

  <h2 class="ml-title-2" style="margin-top: var(--ml-space-8);">05. Indicateur d'étapes (Stepper)</h2>
  <div class="demo-preview">
    <div class="ml-stepper" id="demo-stepper">
      <div class="ml-step completed" data-step="1" style="cursor: pointer;">
        <div class="ml-step-circle">✓</div>
        <div class="ml-step-label">Pièces requises</div>
      </div>
      <div class="ml-step active" data-step="2" style="cursor: pointer;">
        <div class="ml-step-circle">2</div>
        <div class="ml-step-label">Formulaire</div>
      </div>
      <div class="ml-step" data-step="3" style="cursor: pointer;">
        <div class="ml-step-circle">3</div>
        <div class="ml-step-label">Rendez-vous</div>
      </div>
    </div>
  </div>
  <CodeBlock code={`<div class="ml-stepper">
  <!-- Completed step -->
  <div class="ml-step completed">
    <div class="ml-step-circle">✓</div>
    <div class="ml-step-label">Pièces requises</div>
  </div>
  <!-- Active step -->
  <div class="ml-step active">
    <div class="ml-step-circle">2</div>
    <div class="ml-step-label">Formulaire</div>
  </div>
  <!-- Pending step -->
  <div class="ml-step">
    <div class="ml-step-circle">3</div>
    <div class="ml-step-label">Rendez-vous</div>
  </div>
</div>`} lang="html" />

  <h2 class="ml-title-2" style="margin-top: var(--ml-space-8);">06. Menu Latéral (Sidemenu) & Accordéon Mobile</h2>
  <p class="ml-body" style="color: var(--ml-color-neutral-600); margin-bottom: var(--ml-space-4);">
    Le menu latéral (<code>.ml-sidemenu</code>) organise la navigation secondaire d'une sous-section. Sur grand écran, il s'affiche verticalement. Sur mobile ou avec la classe <code>.ml-sidemenu--mobile</code>, il s'enroule sous forme d'un bouton de niveau de rubrique escamotable avec chevron.
  </p>

  <div class="demo-preview" style="display: flex; gap: var(--ml-space-6); flex-wrap: wrap; justify-content: center; background: var(--ml-color-neutral-100); padding: var(--ml-space-6); border-radius: var(--ml-radius-m);">
    <!-- Sidemenu Desktop -->
    <div style="flex: 1; min-width: 260px; max-width: 320px; background: var(--ml-color-neutral-0); border-radius: var(--ml-radius-m); padding: var(--ml-space-4); border: 1px solid var(--ml-color-neutral-200); box-shadow: var(--ml-shadow-ambient);">
      <div style="font-size: 11px; font-weight: 800; color: var(--ml-color-green-emerald); text-transform: uppercase; margin-bottom: 12px;">Affichage Desktop</div>
      <nav class="ml-sidemenu" id="demo-sidemenu-desktop" aria-label="Menu desktop">
        <div class="ml-sidemenu__title">Renseignements Admin</div>
        <ul class="ml-sidemenu__list">
          <li class="ml-sidemenu__item"><a href="#" class="ml-sidemenu__link" onclick="return false;">Périmètre d'application</a></li>
          <li class="ml-sidemenu__item"><a href="#" class="ml-sidemenu__link active" onclick="return false;">Procédure d'agrément</a></li>
          <li class="ml-sidemenu__item"><a href="#" class="ml-sidemenu__link" onclick="return false;">Formulaires officiels</a></li>
        </ul>
      </nav>
    </div>

    <!-- Sidemenu Accordéon Mobile -->
    <div style="flex: 1; min-width: 260px; max-width: 320px; background: var(--ml-color-neutral-0); border-radius: var(--ml-radius-m); padding: var(--ml-space-4); border: 1px solid var(--ml-color-neutral-200); box-shadow: var(--ml-shadow-ambient);">
      <div style="font-size: 11px; font-weight: 800; color: var(--ml-color-gold-amber); text-transform: uppercase; margin-bottom: 12px;">Affichage Mobile (Accordéon)</div>
      <nav class="ml-sidemenu ml-sidemenu--mobile" aria-label="Menu mobile accordéon">
        <button type="button" class="ml-sidemenu__btn" id="demo-sidemenu-acc-btn" aria-expanded="true">
          <span>Dans cette rubrique (3 pages)</span>
          <svg class="ml-sidemenu__btn-icon" id="demo-sidemenu-acc-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="6 9 12 15 18 9"></polyline></svg>
        </button>
        <div class="ml-sidemenu__content" id="demo-sidemenu-acc-content">
          <ul class="ml-sidemenu__list">
            <li class="ml-sidemenu__item"><a href="#" class="ml-sidemenu__link" onclick="return false;">Périmètre d'application</a></li>
            <li class="ml-sidemenu__item"><a href="#" class="ml-sidemenu__link active" onclick="return false;">Procédure d'agrément</a></li>
            <li class="ml-sidemenu__item"><a href="#" class="ml-sidemenu__link" onclick="return false;">Formulaires officiels</a></li>
          </ul>
        </div>
      </nav>
    </div>
  </div>

  <CodeBlock code={`<!-- Desktop side menu / mobile accordion -->
<nav class="ml-sidemenu" aria-label="Menu de section">
  <button type="button" class="ml-sidemenu__btn" aria-expanded="false" aria-controls="sidemenu-content">
    <span>Dans cette rubrique (Nom de la section)</span>
    <svg class="ml-sidemenu__btn-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"></polyline></svg>
  </button>
  <div class="ml-sidemenu__content" id="sidemenu-content">
    <div class="ml-sidemenu__title">Nom de la section</div>
    <ul class="ml-sidemenu__list">
      <li class="ml-sidemenu__item"><a href="#" class="ml-sidemenu__link active">Page active</a></li>
      <li class="ml-sidemenu__item"><a href="#" class="ml-sidemenu__link">Autre page</a></li>
    </ul>
  </div>
</nav>`} lang="html" />

  <h2 class="ml-title-2" style="margin-top: var(--ml-space-8);">07. Sommaire d'in-page (Summary)</h2>
  <p class="ml-body" style="color: var(--ml-color-neutral-600); margin-bottom: var(--ml-space-4);">
    Le sommaire permet à l'usager de naviguer directement entre les différentes sections d'une même page d'article ou de documentation via des ancres.
  </p>
  <div class="demo-preview">
    <nav class="ml-summary" aria-label="Sommaire de la page">
      <div class="ml-summary__title">SOMMAIRE</div>
      <ol class="ml-summary__list">
        <li class="ml-summary__item"><a href="#section1" class="ml-summary__link" onclick="return false;">1. Cadre légal et règlementation</a></li>
        <li class="ml-summary__item"><a href="#section2" class="ml-summary__link" onclick="return false;">2. Administrations concernées</a></li>
        <li class="ml-summary__item"><a href="#section3" class="ml-summary__link" onclick="return false;">3. Questions fréquentes</a></li>
      </ol>
    </nav>
  </div>
  <CodeBlock code={`<nav class="ml-summary" aria-label="Sommaire de la page">
  <div class="ml-summary__title">SOMMAIRE</div>
  <ol class="ml-summary__list">
    <li class="ml-summary__item"><a href="#section1" class="ml-summary__link">1. Cadre légal et règlementation</a></li>
    <li class="ml-summary__item"><a href="#section2" class="ml-summary__link">2. Administrations concernées</a></li>
    <li class="ml-summary__item"><a href="#section3" class="ml-summary__link">3. Questions fréquentes</a></li>
  </ol>
</nav>`} lang="html" />

  <h2 class="ml-title-2" style="margin-top: var(--ml-space-8);">08. Barre d'Administration (Admin Toolbar & Scroll Horizontale Optionnel)</h2>
  <p class="ml-body" style="color: var(--ml-color-neutral-600); margin-bottom: var(--ml-space-4);">
    La barre d'administration (<code>.ml-admin-bar</code>) offre une barre fixe d'actions (sticky en haut sur desktop et ancrée en bas sur mobile). La classe modificatrice optionnelle <code>.ml-admin-bar-scrollable</code> permet un défilement horizontal fluide du contenu sur mobile sans rogner ni déformer les éléments d'action.
  </p>

  <div class="demo-preview" style="display: block; width: 100%; padding: var(--ml-space-4); background: var(--ml-color-neutral-900); border-radius: var(--ml-radius-m);">
    <div class="ml-admin-bar ml-admin-bar-scrollable" style="position: relative; top: auto; bottom: auto; background: transparent; border-bottom: none; box-shadow: none;">
      <div class="ml-admin-bar-container" style="padding: 0; max-width: 100%;">
        <div style="display: flex; align-items: center; gap: 8px; flex-shrink: 0;">
          <span class="ml-badge-admin" style="display: inline-flex; align-items: center; gap: 6px; padding: 3px 8px; border-radius: 9999px; background: rgba(14, 165, 233, 0.15); color: #38bdf8; font-weight: 700; font-size: 11px; text-transform: uppercase;">
            <span style="width: 6px; height: 6px; border-radius: 50%; background-color: #22c55e; box-shadow: 0 0 8px #22c55e;"></span>
            <span>Admin</span>
          </span>
          <div class="ml-segmented-control ml-segmented-control-dark" id="demo-admin-segmented">
            <button type="button" class="ml-segment-btn active" data-segment="preview">Aperçu</button>
            <button type="button" class="ml-segment-btn" data-segment="edit">Édition</button>
          </div>
        </div>
        <div style="display: flex; align-items: center; gap: 8px; flex-shrink: 0;">
          <span id="demo-admin-badge" style="font-size: 12px; color: #38bdf8; background: rgba(56, 189, 248, 0.12); padding: 4px 10px; border-radius: 6px; border: 1px solid rgba(56, 189, 248, 0.25);">3 modifications non enregistrées</span>
          <button type="button" class="ml-btn ml-btn--primary ml-btn--sm" id="demo-admin-save-btn">Enregistrer</button>
        </div>
      </div>
    </div>
  </div>

  <CodeBlock code={`<!-- Standard Admin Bar -->
<div class="ml-admin-bar">
  <div class="ml-admin-bar-container">
    <!-- Barre d'outils d'administration -->
  </div>
</div>

<!-- Optionnel: Barre d'outils avec scroll horizontal fluide sur mobile -->
<div class="ml-admin-bar ml-admin-bar-scrollable">
  <div class="ml-admin-bar-container">
    <!-- Contenu défilable sans déformation -->
  </div>
</div>`} lang="html" />

  <script>
    document.addEventListener("DOMContentLoaded", () => {
      // 0. Main Nav Tabs Interactivity
      const mainNavLinks = document.querySelectorAll<HTMLElement>(".demo-main-nav-link");
      mainNavLinks.forEach((link) => {
        link.addEventListener("click", (e) => {
          e.preventDefault();
          mainNavLinks.forEach((l) => l.classList.remove("active"));
          link.classList.add("active");
        });
      });

      // 1. Dropdown Interactivity
      const dropdownTrigger = document.getElementById("demo-dropdown-trigger");
      const dropdownMenu = document.getElementById("demo-dropdown-menu");

      if (dropdownTrigger && dropdownMenu) {
        dropdownTrigger.addEventListener("click", (e) => {
          e.stopPropagation();
          const isExpanded = dropdownTrigger.getAttribute("aria-expanded") === "true";
          dropdownTrigger.setAttribute("aria-expanded", (!isExpanded).toString());
          dropdownMenu.classList.toggle("show", !isExpanded);
        });

        const items = dropdownMenu.querySelectorAll(".ml-dropdown-item, .dropdown-item");
        items.forEach((item) => {
          item.addEventListener("click", (e) => {
            e.preventDefault();
            items.forEach((i) => i.classList.remove("active"));
            item.classList.add("active");
            setTimeout(() => {
              dropdownMenu.classList.remove("show");
              dropdownTrigger.setAttribute("aria-expanded", "false");
            }, 180);
          });
        });

        document.addEventListener("click", (e) => {
          if (!dropdownTrigger.contains(e.target as Node) && !dropdownMenu.contains(e.target as Node)) {
            dropdownMenu.classList.remove("show");
            dropdownTrigger.setAttribute("aria-expanded", "false");
          }
        });
      }

      // 2. Pagination Interactivity
      const pagBtns = document.querySelectorAll<HTMLElement>(".demo-pag-num");
      pagBtns.forEach((btn) => {
        btn.addEventListener("click", (e) => {
          e.preventDefault();
          pagBtns.forEach((b) => b.classList.remove("active"));
          btn.classList.add("active");
        });
      });

      // 3. Stepper Interactivity
      const steps = document.querySelectorAll<HTMLElement>("#demo-stepper .ml-step");
      steps.forEach((step, idx) => {
        step.addEventListener("click", () => {
          steps.forEach((s, sIdx) => {
            const circle = s.querySelector(".ml-step-circle") as HTMLElement;
            if (!circle) return;

            if (sIdx < idx) {
              s.className = "ml-step completed";
              circle.textContent = "✓";
            } else if (sIdx === idx) {
              s.className = "ml-step active";
              circle.textContent = (sIdx + 1).toString();
            } else {
              s.className = "ml-step";
              circle.textContent = (sIdx + 1).toString();
            }
          });
        });
      });

      // 4. Sidemenu Links Interactivity
      const sidemenuLinks = document.querySelectorAll<HTMLElement>(".ml-sidemenu__link");
      sidemenuLinks.forEach((link) => {
        link.addEventListener("click", (e) => {
          e.preventDefault();
          const nav = link.closest(".ml-sidemenu");
          if (!nav) return;
          nav.querySelectorAll(".ml-sidemenu__link").forEach((l) => l.classList.remove("active"));
          link.classList.add("active");
        });
      });

      // 5. Sidemenu Mobile Accordion Toggle
      const accBtn = document.getElementById("demo-sidemenu-acc-btn");
      if (accBtn) {
        accBtn.addEventListener("click", () => {
          const isOpen = accBtn.getAttribute("aria-expanded") === "true";
          accBtn.setAttribute("aria-expanded", (!isOpen).toString());
        });
      }

      // 6. Admin Toolbar Interactivity
      const segmentedControl = document.getElementById("demo-admin-segmented");
      if (segmentedControl) {
        const segBtns = segmentedControl.querySelectorAll<HTMLElement>(".ml-segment-btn");
        segBtns.forEach((btn) => {
          btn.addEventListener("click", () => {
            segBtns.forEach((b) => b.classList.remove("active"));
            btn.classList.add("active");
          });
        });
      }

      const saveBtn = document.getElementById("demo-admin-save-btn");
      const adminBadge = document.getElementById("demo-admin-badge");
      if (saveBtn) {
        saveBtn.addEventListener("click", () => {
          saveBtn.textContent = "✓ Enregistré !";
          if (adminBadge) {
            adminBadge.textContent = "Modifications enregistrées";
          }
          setTimeout(() => {
            saveBtn.textContent = "Enregistrer";
            if (adminBadge) {
              adminBadge.textContent = "0 modification en attente";
            }
          }, 2200);
        });
      }
    });
  </script>
</DocsLayout>
