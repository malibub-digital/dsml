---
import DocsLayout from '../../layouts/DocsLayout.astro';
import CodeBlock from '../../components/CodeBlock.astro';
---

<DocsLayout
  title="Navigation"
  description="Composants de navigation du DSML (header institutionnel, menu principal, sous-menus dropdown, drawer mobile, breadcrumb, pagination, stepper, sidenav)."
  pageTitle="Navigation & Structure"
  pageSubtitle="Composants essentiels pour structurer la navigation globale et secondaire de vos applications administrative et portails publics."
>

  <h2 class="ml-title-2">01. En-tête Institutionnel & Navigation Principale</h2>
  <p class="ml-body" style="color: var(--ml-color-neutral-600); margin-bottom: var(--ml-space-4);">
    L'en-tête (<code>.ml-header</code>) regroupe l'identité officielle de la République du Mali, la barre tricolore, la barre de recherche globale ainsi que la navigation principale. Il s'adapte dynamiquement en réduisant sa taille au défilement (<code>.ml-header-shrinkable</code>).
  </p>

  <h3 class="ml-title-3" style="font-size: 16px; font-weight: 700; color: var(--ml-color-neutral-800); margin-bottom: var(--ml-space-2);">A. Version Desktop (Barre Horizontale)</h3>

  <div class="demo-preview" style="display: block; width: 100%; padding: 0; overflow: hidden; border: 1px solid var(--ml-color-neutral-200); border-radius: var(--ml-radius-m);">
    <header class="ml-header" style="position: relative; box-shadow: none; border-bottom: 1px solid var(--ml-color-neutral-200);">
      <div class="container" style="max-width: 100%;">
        <div class="header-top" style="display: flex; justify-content: space-between; align-items: center; padding: 12px 16px;">
          <div class="brand-block" style="display: flex; align-items: center; gap: 12px; text-decoration: none; color: inherit;">
            <img src="/dsml/assets/logo-mali.svg" alt="Armoiries du Mali" class="ml-header-logo" width="36" height="36" />
            <div class="brand-text">
              <div class="brand-title" style="font-size: 10px; font-weight: 800; letter-spacing: 0.05em; color: var(--ml-color-green-emerald);">RÉPUBLIQUE DU MALI</div>
              <div class="site-title" style="font-size: 16px; font-weight: 700; color: var(--ml-color-neutral-900);">Portail National des Services</div>
              <div class="ml-tricolor-bar" style="display: flex; height: 3px; width: 100%; margin-top: 4px;">
                <div style="flex: 1; background: var(--ml-color-green-flag);"></div>
                <div style="flex: 1; background: var(--ml-color-yellow-flag);"></div>
                <div style="flex: 1; background: var(--ml-color-red-flag);"></div>
              </div>
            </div>
          </div>
          <div class="header-actions" style="display: flex; gap: var(--ml-space-3); align-items: center;">
            <button class="ml-search-trigger" style="padding: 6px 12px; border: 1px solid var(--ml-color-neutral-300); background: var(--ml-color-neutral-0); border-radius: var(--ml-radius-s); cursor: pointer; display: flex; align-items: center; gap: var(--ml-space-2); font-size: 13px; font-weight: 600; color: var(--ml-color-neutral-700);">
              <svg viewBox="0 0 24 24" style="width: 14px; height: 14px; fill: none; stroke: currentColor; stroke-width: 2.5;"><path d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
              <span>Rechercher</span>
            </button>
          </div>
        </div>
        <nav class="ml-header-nav" style="display: flex; gap: 8px; border-top: 1px solid var(--ml-color-neutral-100); padding: 8px 16px; background: var(--ml-color-neutral-50);">
          <a href="#" class="ml-nav-item active" onclick="return false;" style="padding: 6px 12px; border-radius: var(--ml-radius-s); font-weight: 700; color: var(--ml-color-green-emerald); background: var(--ml-color-green-50); text-decoration: none;">Accueil</a>
          <a href="#" class="ml-nav-item" onclick="return false;" style="padding: 6px 12px; border-radius: var(--ml-radius-s); font-weight: 600; color: var(--ml-color-neutral-700); text-decoration: none;">Démarches</a>
          <a href="#" class="ml-nav-item" onclick="return false;" style="padding: 6px 12px; border-radius: var(--ml-radius-s); font-weight: 600; color: var(--ml-color-neutral-700); text-decoration: none;">Ministères</a>
          <a href="#" class="ml-nav-item" onclick="return false;" style="padding: 6px 12px; border-radius: var(--ml-radius-s); font-weight: 600; color: var(--ml-color-neutral-700); text-decoration: none;">Actualités</a>
        </nav>
      </div>
    </header>
  </div>

  <h3 class="ml-title-3" style="font-size: 16px; font-weight: 700; color: var(--ml-color-neutral-800); margin-top: var(--ml-space-6); margin-bottom: var(--ml-space-2);">B. Version Mobile & Tablette (Bouton Burger & Tiroir Accordéon)</h3>
  <p class="ml-body" style="color: var(--ml-color-neutral-600); margin-bottom: var(--ml-space-4);">
    En dessous de <code>860px</code>, la navigation horizontale bascule automatiquement en mode mobile : le bouton burger (<code>.ml-header-burger</code>) apparaît et la navigation s'ouvre sous forme de tiroir déroulant (<code>.ml-header-nav.is-open</code>) doté d’un en-tête d'action (<code>.ml-header-nav-header</code>) avec bouton de fermeture (<code>.ml-header-nav-close</code>).
  </p>

  <div class="demo-preview" style="display: flex; gap: var(--ml-space-6); flex-wrap: wrap; justify-content: center; background: var(--ml-color-neutral-100); padding: var(--ml-space-6); border-radius: var(--ml-radius-m);">
    <!-- Simulation Smartphone Fermé -->
    <div style="width: 320px; border: 2px solid var(--ml-color-neutral-300); border-radius: 16px; background: var(--ml-color-neutral-0); overflow: hidden; box-shadow: var(--ml-shadow-ambient);">
      <div style="background: var(--ml-color-neutral-200); padding: 4px 12px; font-size: 11px; font-weight: 700; color: var(--ml-color-neutral-700); text-align: center; border-bottom: 1px solid var(--ml-color-neutral-300);">Écran mobile (Fermé)</div>
      <header class="ml-header" style="box-shadow: none;">
        <div style="display: flex; justify-content: space-between; align-items: center; padding: 10px 14px;">
          <div style="display: flex; align-items: center; gap: 8px;">
            <img src="/dsml/assets/logo-mali.svg" alt="Mali" width="28" height="28" />
            <div>
              <div style="font-size: 8px; font-weight: 800; color: var(--ml-color-green-emerald);">RÉPUBLIQUE DU MALI</div>
              <div style="font-size: 13px; font-weight: 700;">Portail National</div>
            </div>
          </div>
          <button class="ml-header-burger" style="display: flex; width: 36px; height: 36px;" aria-label="Ouvrir le menu">
            <svg viewBox="0 0 24 24" style="width: 18px; height: 18px;"><path d="M4 6h16M4 12h16M4 18h16"></path></svg>
          </button>
        </div>
      </header>
    </div>

    <!-- Simulation Smartphone Ouvert -->
    <div style="width: 320px; border: 2px solid var(--ml-color-green-500); border-radius: 16px; background: var(--ml-color-neutral-0); overflow: hidden; box-shadow: var(--ml-shadow-elevated);">
      <div style="background: var(--ml-color-green-100); padding: 4px 12px; font-size: 11px; font-weight: 700; color: var(--ml-color-green-800); text-align: center; border-bottom: 1px solid var(--ml-color-green-200);">Écran mobile (Tiroir Ouvert)</div>
      <header class="ml-header" style="box-shadow: none;">
        <div style="display: flex; justify-content: space-between; align-items: center; padding: 10px 14px; border-bottom: 1px solid var(--ml-color-neutral-100);">
          <div style="display: flex; align-items: center; gap: 8px;">
            <img src="/dsml/assets/logo-mali.svg" alt="Mali" width="28" height="28" />
            <div>
              <div style="font-size: 8px; font-weight: 800; color: var(--ml-color-green-emerald);">RÉPUBLIQUE DU MALI</div>
              <div style="font-size: 13px; font-weight: 700;">Portail National</div>
            </div>
          </div>
          <button class="ml-header-burger" style="display: flex; width: 36px; height: 36px; background: var(--ml-color-green-50); border-color: var(--ml-color-green-300); color: var(--ml-color-green-700);" aria-label="Menu ouvert" aria-expanded="true">
            <svg viewBox="0 0 24 24" style="width: 18px; height: 18px;"><path d="M6 18L18 6M6 6l12 12"></path></svg>
          </button>
        </div>
        <nav class="ml-header-nav is-open" style="display: flex !important; flex-direction: column; background: var(--ml-color-neutral-0);">
          <div class="ml-header-nav-header" style="display: flex; justify-content: space-between; align-items: center; padding: 10px 16px; border-bottom: 1px solid var(--ml-color-neutral-200); font-weight: 800; font-size: 13px; color: var(--ml-color-neutral-900);">
            <span>Navigation Principale</span>
            <button class="ml-header-nav-close" style="border: none; background: transparent; font-size: 20px; font-weight: bold; cursor: pointer; color: var(--ml-color-neutral-600);">&times;</button>
          </div>
          <a href="#" class="ml-nav-item active" onclick="return false;" style="padding: 10px 16px; border-left: 4px solid var(--ml-color-green-500); background: var(--ml-color-green-50); font-weight: 700; color: var(--ml-color-green-700); text-decoration: none;">Accueil</a>
          <a href="#" class="ml-nav-item" onclick="return false;" style="padding: 10px 16px; border-left: 4px solid transparent; color: var(--ml-color-neutral-800); text-decoration: none; border-top: 1px solid var(--ml-color-neutral-100);">Démarches admin</a>
          <a href="#" class="ml-nav-item" onclick="return false;" style="padding: 10px 16px; border-left: 4px solid transparent; color: var(--ml-color-neutral-800); text-decoration: none; border-top: 1px solid var(--ml-color-neutral-100);">Ministères & Institutions</a>
          <a href="#" class="ml-nav-item" onclick="return false;" style="padding: 10px 16px; border-left: 4px solid transparent; color: var(--ml-color-neutral-800); text-decoration: none; border-top: 1px solid var(--ml-color-neutral-100);">Actualités</a>
        </nav>
      </header>
    </div>
  </div>

  <CodeBlock code={`<!-- HTML : Structure En-tête Desktop & Mobile avec tiroir burger -->
<header class="ml-header ml-header-sticky ml-header-shrinkable" id="site-header">
  <div class="container">
    <div class="header-top">
      <a href="/" class="brand-block">
        <img src="/dsml/assets/logo-mali.svg" alt="Armoiries du Mali" class="ml-header-logo" width="42" height="42" />
        <div class="brand-text">
          <div class="brand-title">RÉPUBLIQUE DU MALI</div>
          <div class="site-title">Nom de l'Administration</div>
          <div class="ml-tricolor-bar">
            <div class="green"></div>
            <div class="yellow"></div>
            <div class="red"></div>
          </div>
        </div>
      </a>
      <div class="header-actions">
        <!-- Bouton Burger visible sur écran mobile (<860px) -->
        <button class="ml-header-burger" id="header-burger" aria-label="Menu principal" aria-expanded="false">
          <svg viewBox="0 0 24 24"><path d="M4 6h16M4 12h16M4 18h16"></path></svg>
        </button>
      </div>
    </div>
    <!-- Tiroir de Navigation principal -->
    <nav class="ml-header-nav" id="header-nav" aria-label="Menu principal">
      <div class="ml-header-nav-header">
        <span>Navigation</span>
        <button class="ml-header-nav-close" id="header-nav-close" aria-label="Fermer le menu">&times;</button>
      </div>
      <a href="/" class="ml-nav-item active">Accueil</a>
      <a href="/demarches/" class="ml-nav-item">Démarches</a>
      <a href="/actualites/" class="ml-nav-item">Actualités</a>
    </nav>
  </div>
</header>

<!-- JavaScript Vanilla : Gestion de l'ouverture / fermeture mobile -->
<script>
  const burgerBtn = document.getElementById('header-burger');
  const closeBtn = document.getElementById('header-nav-close');
  const navMenu = document.getElementById('header-nav');

  function toggleMenu() {
    const isOpen = navMenu.classList.toggle('is-open');
    burgerBtn.setAttribute('aria-expanded', isOpen.toString());
  }

  burgerBtn?.addEventListener('click', toggleMenu);
  closeBtn?.addEventListener('click', toggleMenu);
</script>`} lang="html" />

  <h2 class="ml-title-2" style="margin-top: var(--ml-space-8);">02. Sous-Menu et Menu Déroulant (Dropdown)</h2>
  <p class="ml-body" style="color: var(--ml-color-neutral-600); margin-bottom: var(--ml-space-4);">
    Les sous-menus contextuels s'affichent sous forme de panneau flottant en verre dépoli (glassmorphism) lors du survol ou du clic sur l'élément déclencheur.
  </p>

  <div class="demo-preview" style="display: flex; justify-content: center; padding: 40px var(--ml-space-4); background: var(--ml-color-neutral-100); border-radius: var(--ml-radius-m);">
    <div class="dropdown-container" style="position: relative; display: inline-block;">
      <button type="button" class="dropdown-trigger" style="display: inline-flex; align-items: center; gap: 6px; color: var(--ml-color-green-emerald); font-family: var(--ml-font-title); font-weight: 700; font-size: 14px; padding: 8px 16px; border-radius: var(--ml-radius-pill); background-color: var(--ml-color-green-50); border: 1px solid var(--ml-color-green-200); cursor: pointer;">
        <span>Espace Citoyen / Agent</span>
        <svg viewBox="0 0 24 24" style="width: 14px; height: 14px; fill: none; stroke: currentColor; stroke-width: 2;"><path d="M6 9l6 6 6-6"></path></svg>
      </button>
      <div class="dropdown-menu show" style="position: relative; top: 8px; right: 0; width: 240px; background: var(--ml-color-neutral-0); border: 1px solid var(--ml-color-neutral-200); border-radius: var(--ml-radius-m); box-shadow: var(--ml-shadow-ambient); padding: var(--ml-space-2); display: flex; flex-direction: column; gap: 2px;">
        <div class="dropdown-title" style="font-size: 10px; font-weight: 800; letter-spacing: 0.08em; color: var(--ml-color-neutral-500); padding: 6px 10px 4px; text-transform: uppercase;">Accès sécurisé</div>
        <a href="#" class="dropdown-item" onclick="return false;" style="text-decoration: none; color: var(--ml-color-neutral-900); font-size: 14px; padding: 8px 10px; border-radius: var(--ml-radius-s); display: flex; align-items: center; gap: 8px; background: var(--ml-color-green-50); color: var(--ml-color-green-emerald); font-weight: 600;">
          <span class="dropdown-dot user" style="width: 8px; height: 8px; border-radius: 50%; background-color: var(--ml-color-green-500);"></span>
          Mes Démarches en ligne
        </a>
        <a href="#" class="dropdown-item" onclick="return false;" style="text-decoration: none; color: var(--ml-color-neutral-900); font-size: 14px; padding: 8px 10px; border-radius: var(--ml-radius-s); display: flex; align-items: center; gap: 8px;">
          <span class="dropdown-dot agent" style="width: 8px; height: 8px; border-radius: 50%; background-color: var(--ml-color-gold-amber);"></span>
          Portail Agent Public
        </a>
        <div class="dropdown-divider" style="height: 1px; background-color: var(--ml-color-neutral-200); margin: 4px 6px;"></div>
        <a href="#" class="dropdown-item" onclick="return false;" style="text-decoration: none; color: var(--ml-color-neutral-700); font-size: 13px; padding: 8px 10px;">Aide & Support technique</a>
      </div>
    </div>
  </div>

  <CodeBlock code={`<!-- Menu déroulant (Sous-menu contextuel) -->
<div class="dropdown-container">
  <button type="button" class="dropdown-trigger" aria-expanded="true">
    <span>Espace Citoyen</span>
    <svg viewBox="0 0 24 24" width="14" height="14"><path d="M6 9l6 6 6-6"></path></svg>
  </button>
  <div class="dropdown-menu show">
    <div class="dropdown-title">Accès sécurisé</div>
    <a href="#" class="dropdown-item">
      <span class="dropdown-dot user"></span>
      Mes Démarches en ligne
    </a>
    <a href="#" class="dropdown-item">
      <span class="dropdown-dot agent"></span>
      Portail Agent Public
    </a>
    <div class="dropdown-divider"></div>
    <a href="#" class="dropdown-item">Aide & Support</a>
  </div>
</div>`} lang="html" />

  <h2 class="ml-title-2" style="margin-top: var(--ml-space-8);">03. Fil d'Ariane (Breadcrumbs)</h2>
  <div class="demo-preview" style="display: block; width: 100%;">
    <nav class="ml-breadcrumb" aria-label="Fil d'Ariane">
      <ol class="ml-breadcrumb-list" style="display: flex; list-style: none; padding: 0; margin: 0; gap: var(--ml-space-2); font-size: 14px;">
        <li class="ml-breadcrumb-item"><a href="#" onclick="return false;" style="text-decoration: none; color: var(--ml-color-neutral-600);">Accueil</a></li>
        <li class="ml-breadcrumb-item"><span style="margin-right: 8px; color: var(--ml-color-neutral-400);">/</span><a href="#" onclick="return false;" style="text-decoration: none; color: var(--ml-color-neutral-600);">Démarches</a></li>
        <li class="ml-breadcrumb-item active" aria-current="page" style="font-weight: bold; color: var(--ml-color-neutral-900);"><span style="margin-right: 8px; color: var(--ml-color-neutral-400);">/</span>Carte Consulaire</li>
      </ol>
    </nav>
  </div>
  <CodeBlock code={`<nav class="ml-breadcrumb" aria-label="Fil d'Ariane">
  <ol class="ml-breadcrumb-list">
    <li class="ml-breadcrumb-item"><a href="#">Accueil</a></li>
    <li class="ml-breadcrumb-item"><a href="#">Démarches</a></li>
    <li class="ml-breadcrumb-item active" aria-current="page">Carte Consulaire</li>
  </ol>
</nav>`} lang="html" />

  <h2 class="ml-title-2" style="margin-top: var(--ml-space-8);">04. Pagination</h2>
  <div class="demo-preview">
    <nav class="ml-pagination" aria-label="Pagination">
      <a href="#" class="ml-pagination-btn disabled" onclick="return false;">‹ Préc.</a>
      <a href="#" class="ml-pagination-btn active" onclick="return false;">1</a>
      <a href="#" class="ml-pagination-btn" onclick="return false;">2</a>
      <span class="ml-pagination-ellipsis">...</span>
      <a href="#" class="ml-pagination-btn" onclick="return false;">10</a>
      <a href="#" class="ml-pagination-btn" onclick="return false;">Suiv. ›</a>
    </nav>
  </div>
  <CodeBlock code={`<nav class="ml-pagination" aria-label="Pagination">
  <a href="#" class="ml-pagination-btn disabled">‹ Préc.</a>
  <a href="#" class="ml-pagination-btn active">1</a>
  <a href="#" class="ml-pagination-btn">2</a>
  <span class="ml-pagination-ellipsis">...</span>
  <a href="#" class="ml-pagination-btn">10</a>
  <a href="#" class="ml-pagination-btn">Suiv. ›</a>
</nav>`} lang="html" />

  <h2 class="ml-title-2" style="margin-top: var(--ml-space-8);">05. Indicateur d'étapes (Stepper)</h2>
  <div class="demo-preview" style="display: block; width: 100%;">
    <div class="ml-stepper" style="display: flex; gap: var(--ml-space-4); justify-content: space-between; flex-wrap: wrap;">
      <div class="ml-step completed" style="display: flex; align-items: center; gap: var(--ml-space-2);">
        <div class="ml-step-circle" style="width: 28px; height: 28px; border-radius: 50%; background: var(--ml-color-green-500); color: white; display: flex; align-items: center; justify-content: center; font-weight: bold;">✓</div>
        <div class="ml-step-label" style="font-weight: 500; color: var(--ml-color-neutral-600);">Pièces requises</div>
      </div>
      <div class="ml-step active" style="display: flex; align-items: center; gap: var(--ml-space-2);">
        <div class="ml-step-circle" style="width: 28px; height: 28px; border-radius: 50%; background: var(--ml-color-green-500); color: white; display: flex; align-items: center; justify-content: center; font-weight: bold;">2</div>
        <div class="ml-step-label" style="font-weight: bold; color: var(--ml-color-neutral-900);">Formulaire</div>
      </div>
      <div class="ml-step" style="display: flex; align-items: center; gap: var(--ml-space-2);">
        <div class="ml-step-circle" style="width: 28px; height: 28px; border-radius: 50%; background: var(--ml-color-neutral-200); color: var(--ml-color-neutral-600); display: flex; align-items: center; justify-content: center; font-weight: bold;">3</div>
        <div class="ml-step-label" style="font-weight: 500; color: var(--ml-color-neutral-400);">Rendez-vous</div>
      </div>
    </div>
  </div>
  <CodeBlock code={`<div class="ml-stepper">
  <!-- Completed step -->
  <div class="ml-step completed">
    <div class="ml-step-circle">1</div>
    <div class="ml-step-label">Pièces requises</div>
  </div>
  <!-- Active step -->
  <div class="ml-step active">
    <div class="ml-step-circle">2</div>
    <div class="ml-step-label">Formulaire</div>
  </div>
  <!-- Pending step -->
  <div class="ml-step">
    <div class="ml-step-circle">3</div>
    <div class="ml-step-label">Rendez-vous</div>
  </div>
</div>`} lang="html" />

  <h2 class="ml-title-2" style="margin-top: var(--ml-space-8);">06. Menu Latéral (Sidemenu) & Accordéon Mobile</h2>
  <p class="ml-body" style="color: var(--ml-color-neutral-600); margin-bottom: var(--ml-space-4);">
    Le menu latéral (<code>.ml-sidemenu</code>) organise la navigation secondaire d'une sous-section. Sur grand écran, il s'affiche verticalement. Sur mobile, il s'enroule sous forme d'un bouton de niveau de rubrique escamotable avec chevron.
  </p>

  <div class="demo-preview" style="display: flex; gap: var(--ml-space-6); flex-wrap: wrap; justify-content: center; background: var(--ml-color-neutral-100); padding: var(--ml-space-6); border-radius: var(--ml-radius-m);">
    <!-- Sidemenu Desktop -->
    <div style="flex: 1; min-width: 260px; max-width: 320px; background: var(--ml-color-neutral-0); border-radius: var(--ml-radius-m); padding: var(--ml-space-4); border: 1px solid var(--ml-color-neutral-200); box-shadow: var(--ml-shadow-ambient);">
      <div style="font-size: 11px; font-weight: 800; color: var(--ml-color-green-emerald); text-transform: uppercase; margin-bottom: 8px;">Affichage Desktop</div>
      <nav class="ml-sidemenu" aria-label="Menu desktop">
        <div class="ml-sidemenu__title" style="font-weight: 800; font-size: 14px; color: var(--ml-color-neutral-900); padding-bottom: 8px; border-bottom: 2px solid var(--ml-color-green-500); margin-bottom: 8px;">Renseignements Admin</div>
        <ul class="ml-sidemenu__list" style="list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 4px;">
          <li class="ml-sidemenu__item"><a href="#" class="ml-sidemenu__link active" onclick="return false;" style="display: block; padding: 8px 12px; border-radius: var(--ml-radius-s); background: var(--ml-color-green-50); color: var(--ml-color-green-700); font-weight: 700; text-decoration: none;">Périmètre d'application</a></li>
          <li class="ml-sidemenu__item"><a href="#" class="ml-sidemenu__link" onclick="return false;" style="display: block; padding: 8px 12px; border-radius: var(--ml-radius-s); color: var(--ml-color-neutral-700); text-decoration: none;">Procédure d'agrément</a></li>
          <li class="ml-sidemenu__item"><a href="#" class="ml-sidemenu__link" onclick="return false;" style="display: block; padding: 8px 12px; border-radius: var(--ml-radius-s); color: var(--ml-color-neutral-700); text-decoration: none;">Formulaires officiels</a></li>
        </ul>
      </nav>
    </div>

