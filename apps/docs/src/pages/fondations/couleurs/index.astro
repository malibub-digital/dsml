  <script>
    // Live Theme Selector Logic
    const themeBtns = document.querySelectorAll('[data-set-theme]');
    const previewBox = document.getElementById('themePreviewBox');

    themeBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const theme = btn.getAttribute('data-set-theme');
        themeBtns.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        if (previewBox) {
          previewBox.setAttribute('data-theme', theme);
        }
      });
    });

    // Copy swatch code to clipboard
    const toast = document.getElementById('copyToast');
    const swatches = document.querySelectorAll('.color-swatch[data-copy]');

    swatches.forEach(swatch => {
      swatch.addEventListener('click', () => {
        const code = swatch.getAttribute('data-copy');
        if (code) {
          navigator.clipboard.writeText(`var(${code})`).then(() => {
            if (toast) {
              toast.textContent = `Copié : var(${code})`;
              toast.classList.add('show');
              setTimeout(() => {
                toast.classList.remove('show');
              }, 2200);
            }
          });
        }
      });
    });
  </script>

