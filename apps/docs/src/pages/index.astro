  <script>
    document.addEventListener('DOMContentLoaded', () => {

      // --- Bouton Copier snippet ---
      const copyBtn = document.getElementById('snippet-copy-btn');
      if (copyBtn) {
        copyBtn.addEventListener('click', () => {
          const text = `<link rel="preconnect" href="https://fonts.googleapis.com">\n<link href="https://fonts.googleapis.com/css2?family=Archivo:wght@500;600;700;800&family=Atkinson+Hyperlegible:ital,wght@0,400;0,700;1,400&display=swap" rel="stylesheet">\n\n<link rel="stylesheet" href="https://cdn.dsml.ml/v0.1/dsml.css">`;
          navigator.clipboard.writeText(text).then(() => {
            copyBtn.textContent = '✓ Copié !';
            copyBtn.style.color = '#6EE89A';
            setTimeout(() => {
              copyBtn.textContent = 'Copier';
              copyBtn.style.color = '';
            }, 2000);
          }).catch(() => {
            copyBtn.textContent = 'Erreur';
            setTimeout(() => copyBtn.textContent = 'Copier', 2000);
          });
        });
      }

    });
  </script>

