---
---
<!DOCTYPE html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Démo Header Sticky — DSML</title>
    <link rel="stylesheet" href="/dsml/css/dsml.css" />
    <style>
      body {
        margin: 0;
        padding: 0;
        background-color: var(--ml-color-neutral-50);
        font-family: var(--ml-font-body);
        color: var(--ml-color-neutral-900);
      }
      .demo-content {
        padding: var(--ml-space-8) var(--ml-space-4);
        max-width: 900px;
        margin: 0 auto;
      }
      .demo-card {
        background: var(--ml-color-neutral-0);
        padding: var(--ml-space-6);
        border-radius: var(--ml-radius-l);
        border: 1px solid var(--ml-color-neutral-200);
        margin-bottom: var(--ml-space-6);
        box-shadow: var(--ml-shadow-soft);
      }
      .demo-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: var(--ml-space-4);
        margin-top: var(--ml-space-4);
      }
      .demo-item {
        background: var(--ml-color-neutral-100);
        padding: var(--ml-space-4);
        border-radius: var(--ml-radius-m);
        border: 1px solid var(--ml-color-neutral-200);
      }
    </style>
  </head>
  <body>
    <header class="ml-header ml-header-sticky" id="demo-header">
      <div class="container">
        <div class="header-top">
          <a href="#" class="brand-block">
            <img src="/dsml/assets/logo-mali.svg" alt="Armoiries du Mali" class="ml-header-logo" />
            <div class="brand-text">
              <div class="brand-title">RÉPUBLIQUE DU MALI</div>
              <div class="site-title">Portail National des Démarches</div>
              <div class="ml-tricolor-bar">
                <div class="green"></div>
                <div class="yellow"></div>
                <div class="red"></div>
              </div>
            </div>
          </a>
          <div class="header-actions">
            <a href="#" class="header-link">Connexion</a>
            <button class="ml-header-burger" id="burger-btn" aria-label="Menu Mobile">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M4 6h16M4 12h16M4 18h16"></path>
              </svg>
            </button>
          </div>
        </div>
        <nav class="ml-header-nav" id="demo-nav" aria-label="Menu principal">
          <div class="ml-header-nav-header">
            <span>Navigation</span>
            <button class="ml-header-nav-close" id="close-btn" aria-label="Fermer le menu">&times;</button>
          </div>
          <a href="#" class="ml-nav-item active">Accueil</a>
          <a href="#" class="ml-nav-item">Passeport & CNI</a>
          <a href="#" class="ml-nav-item">État Civil</a>
          <a href="#" class="ml-nav-item">Contact</a>
        </nav>
      </div>
    </header>

    <main class="demo-content">
      <div class="demo-card">
        <div class="ml-badge ml-badge-warning" style="margin-bottom: var(--ml-space-2);">Option Fixe (Sticky)</div>
        <h1 class="ml-title-1">Mode 2 : En-tête Fixe (<code>.ml-header-sticky</code>)</h1>
        <p class="ml-body">
          L'en-tête reste constamment ancré au sommet de votre écran avec un effet de fond translucide (<code>backdrop-filter</code>) et une ombre douce au défilement.
        </p>
      </div>

      <div class="demo-card">
        <h2 class="ml-title-2">Test de défilement (Sticky)</h2>
        <p class="ml-body">
          Faites défiler cette page : l'en-tête reste figé en haut de la fenêtre quel que soit votre niveau de défilement dans la page.
        </p>
      </div>

      <div class="demo-card">
        <h3 class="ml-title-3">Services Rapides Disponibles</h3>
        <div class="demo-grid">
          <div class="demo-item">
            <h4 class="ml-label">Demande de Passeport Biométrique</h4>
            <p class="ml-body-compact">Prise de rendez-vous en ligne et pré-enrôlement.</p>
          </div>
          <div class="demo-item">
            <h4 class="ml-label">Carte NINA & CNI</h4>
            <p class="ml-body-compact">Vérification et mise à jour des données d'état civil.</p>
          </div>
          <div class="demo-item">
            <h4 class="ml-label">Casier Judiciaire</h4>
            <p class="ml-body-compact">Demande et délivrance du bulletin n°3 en ligne.</p>
          </div>
          <div class="demo-item">
            <h4 class="ml-label">Permis de Conduire</h4>
            <p class="ml-body-compact">Renouvellement et vérification du statut des points.</p>
          </div>
        </div>
      </div>

      <div class="demo-card" style="height: 350px;">
        <h3 class="ml-title-3">Section de contenu prolongée 1</h3>
        <p class="ml-body">Vérifiez que l'en-tête reste bien fixe au sommet pendant toute la durée du défilement.</p>
      </div>

      <div class="demo-card" style="height: 350px;">
        <h3 class="ml-title-3">Section de contenu prolongée 2</h3>
        <p class="ml-body">Test de défilement fluide.</p>
      </div>

      <div class="demo-card" style="height: 350px;">
        <h3 class="ml-title-3">Section de contenu prolongée 3</h3>
        <p class="ml-body-compact">Pied de page de démonstration.</p>
      </div>
    </main>

    <script>
      document.addEventListener('DOMContentLoaded', () => {
        const burgerBtn = document.getElementById('burger-btn');
        const closeBtn = document.getElementById('close-btn');
        const nav = document.getElementById('demo-nav');

        if (burgerBtn && nav) {
          burgerBtn.addEventListener('click', () => nav.classList.toggle('is-open'));
        }
        if (closeBtn && nav) {
          closeBtn.addEventListener('click', () => nav.classList.remove('is-open'));
        }
      });
    </script>
  </body>
</html>
